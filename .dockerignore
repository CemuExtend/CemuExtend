# Never send console credentials, account configuration, saves, logs, dumps,
# or other user-owned emulator state to the Docker daemon. These mirror the
# private runtime paths in .gitignore and protect every `COPY . .` stage.
bin/otp.bin
bin/seeprom.bin
bin/keys.txt
bin/settings.xml
bin/network_services.xml
bin/title_list_cache.xml
bin/log.txt
bin/mlc01/
bin/debugger/
bin/sdcard/
bin/screenshots/
bin/dump/
bin/cafeLibs/
bin/portable/
bin/shaderCache/
bin/controllerProfiles/
bin/graphicPacks/
bin/gameProfiles/*
!bin/gameProfiles/default/
!bin/gameProfiles/default/**

# Commercial title/container material and private compatibility fixtures are
# never Docker build inputs. Synthetic test programs are generated from source.
**/*.rpx
**/*.rpl
**/*.wua
**/*.wud
**/*.wux
**/*.tik
**/*.tmd
**/*.cemod
**/*.wps
**/*.wms
**/.env*
**/*.pem
**/*.p12
**/*.pfx
**/*.key
**/*.app
**/*.h3
**/*.cert
**/*.wuhb
**/*.elf
**/otp.bin
**/seeprom.bin
**/keys.txt
**/settings.xml
**/network_services.xml
**/.npmrc
**/.netrc
**/.cargo/credentials*
**/.ssh/
**/id_rsa*
**/id_ed25519*
**/credentials*.json
# Canonical traces and comparator reports are generated artifacts. Even when
# redacted, they contain guest register/state observations and must never be
# copied back into a later Docker build context.
**/*.jsonl
**/*.trace
**/*.trace-report.json
# These exact public synthetic traces are tracked fixed-oracle CI inputs.
!compat/golden/rpx-contract-positive-v1.jsonl
!compat/golden/rpl-link-contract-positive-v1.jsonl
!compat/golden/rpl-call-link-positive-v1.jsonl
!compat/golden/rpl-call-execution-positive-v1.jsonl
**/oracle-output/
**/private-fixtures/
**/fixtures/private/
**/test-data/private/
dependencies/vcpkg/buildtrees/
dependencies/vcpkg/packages/
dependencies/vcpkg/downloads/
dependencies/vcpkg/installed/
dependencies/.cef-downloads/
dependencies/cef/Debug/
ui/node_modules/
ui/dist/

# The Rust rewrite build does not consume the legacy C++ tree or vendored
# submodules.  Keep them out even though the historical C++ Docker rules above
# re-include parts of .git/modules and bin/gameProfiles.
.git/
dependencies/
src/
bin/
cmake/
