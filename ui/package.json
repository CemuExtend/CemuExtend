{
  "name": "cemuextend-web-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate": "bun run scripts/generate-contracts.ts && bun run scripts/convert-translations.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "bun test",
    "build": "vite build",
    "build:embedded": "bun run build && bun run scripts/embed-assets.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "7.1.3",
    "typescript": "5.9.2",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/bun": "1.2.21",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "eslint": "9.33.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "typescript-eslint": "8.40.0"
  }
}
