if(input_host_event_violations)
	list(JOIN input_host_event_violations "\n  " formatted)
	message(FATAL_ERROR "Normal wx pointer input must use the injected host-event port:\n  ${formatted}")
endif()
if(debugger_adapter_boundary_violations)
	list(JOIN debugger_adapter_boundary_violations "\n  " formatted)
	message(FATAL_ERROR "Debugger adapters must keep core types and detached workers out of their public boundaries:\n  ${formatted}")
endif()
