file(GLOB_RECURSE architecture_sources
	"${SOURCE_ROOT}/src/*.h"
	"${SOURCE_ROOT}/src/*.hpp"
	"${SOURCE_ROOT}/src/*.cpp"
	"${SOURCE_ROOT}/src/CMakeLists.txt")

set(locator_violations "")
set(lower_gui_violations "")
set(cafe_ui_violations "")
set(title_ui_violations "")
set(graphic_pack_ui_violations "")
set(game_list_ui_violations "")
set(title_manager_event_violations "")
set(checksum_ui_violations "")
set(update_ui_violations "")
set(main_window_path_violations "")
set(hotkey_path_violations "")
set(input_settings_path_violations "")
set(general_settings_path_violations "")
set(game_profile_ui_violations "")
set(title_install_ui_violations "")
set(wx_wire_violations "")
set(wx_presentation_violations "")
set(wx_vsync_violations "")
set(wx_swkbd_violations "")
set(wx_nfc_violations "")
set(wx_renderer_adapter_violations "")
set(wx_audio_spec_violations "")
set(download_list_title_violations "")
set(debugger_adapter_boundary_violations "")
set(account_ui_violations "")
set(save_ui_violations "")
set(frontend_runtime_violations "")
set(wx_native_handle_violations "")
set(wx_window_state_violations "")
set(text_input_callback_violations "")
set(input_host_event_violations "")
set(input_profile_layer_violations "")
set(normal_wx_cafe_include_violations "")
set(wx_adapter_contract_violations "")

foreach(source IN LISTS architecture_sources)
	file(READ "${source}" content)
	if(content MATCHES "gui/interface/WindowSystem\\.h|interface/WindowSystem\\.h|WindowSystem::|WxFrontendRuntime\\.h|WxFrontendRuntime::")
		list(APPEND frontend_runtime_violations "${source}")
	endif()
	if(content MATCHES "Frontend::GetHostServices|frontend/HostServices\\.h")
		list(APPEND locator_violations "${source}")
	endif()

	if(source MATCHES "/src/(Cafe|Cemu|input|audio|imgui|config)/")
		if(content MATCHES "gui/interface/WindowSystem\\.h|interface/WindowSystem\\.h|WindowSystem::")
			list(APPEND lower_gui_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/Cafe/" AND content MATCHES "#include[ \t]*[<\"]wx/|#include[ \t]*[<\"]wx")
		list(APPEND cafe_ui_violations "${source}")
	endif()

	# Input is the lower host-input layer. Cafe consumes its value contracts; no
	# Cafe implementation or global config dependency may point back down.
	if(source MATCHES "/src/input/")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|config/ActiveSettings|g_current_game_profile")
			list(APPEND input_profile_layer_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/(canvas/(IRenderCanvas|RendererWindowAdapter)|debugger/(DebuggerWindowAdapter|MemorySearcherAdapter)|EmulatedUSBDevices/EmulatedUSBDeviceAdapter)\.h$")
		if(content MATCHES "#include[ \t]*[<\"](Cafe/|config/|input/|application/|Cemu/)|CafeSystem|g_renderer|DebuggerWindow2|MemorySearcherTool|EmulatedUSBDeviceFrame")
			list(APPEND wx_adapter_contract_violations "${source}")
		endif()
	endif()

	# All direct Cafe includes in wx live in the explicit adapter archives. The
	# normal GUI archive must remain on neutral Application/Host/Input contracts.
	if(source MATCHES "/src/gui/wxgui/.*\.(h|cpp)$" AND
		content MATCHES "#include[ \t]*[<\"]Cafe/")
		if(NOT source MATCHES "/src/gui/wxgui/(canvas/|debugger/|EmulatedUSBDevices/|windows/PPCThreadsViewer/|windows/TextureRelationViewer/|AudioDebuggerWindow\.(h|cpp)$|MemorySearcherTool\.(h|cpp)$)")
			list(APPEND normal_wx_cafe_include_violations "${source}")
		endif()
	endif()

	# These normal frontend files have moved behind Application::ITitleCatalog.
	# Prevent accidental reintroduction while the larger game-list/title-manager
	# migration proceeds through its own copied DTO/event boundary.
	if(source MATCHES "/src/gui/wxgui/(MainWindow|CemuApp|GeneralSettings2|GettingStartedDialog)\\.(h|cpp)$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/TitleList/|CafeTitleList::|CafeSaveList::|TitleInfo|GameInfo2")
			list(APPEND title_ui_violations "${source}")
		endif()
	endif()

	# Graphic-pack windows consume copied Application DTOs and commands only.
	if(source MATCHES "/src/gui/wxgui/(GraphicPacksWindow2|DownloadGraphicPacksWindow|DownloadCustomGraphicPackWindow)\\.(h|cpp)$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|GraphicPack2|CafeSystem::|CafeTitleList::|LatteAsyncCommands|#include[ \t]*[<\"]config/ActiveSettings|ActiveSettings::")
			list(APPEND graphic_pack_ui_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/components/wxGameList\\.(h|cpp)$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|CafeTitleList|GameInfo2|TitleInfo|iosu::pdm|fsc_extractFile|FSC_PRIORITY|config/ActiveSettings|ActiveSettings::")
			list(APPEND game_list_ui_violations "${source}")
		endif()
	endif()

	# Title-manager discovery/removal/scan events and WUA conversion cross the
	# Application boundary as copied values and content-operation requests.
	if(source MATCHES "/src/gui/wxgui/(TitleManager|components/wxTitleManagerList)\\.h$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|CafeConsoleRegion|CafeTitleListCallbackEvent|CafeSaveListCallbackEvent")
			list(APPEND title_manager_event_violations "${source}")
		endif()
	elseif(source MATCHES "/src/gui/wxgui/TitleManager\\.cpp$")
		if(content MATCHES "CafeTitleList::|CafeSaveList::|CafeTitleListCallbackEvent|CafeSaveListCallbackEvent")
			list(APPEND title_manager_event_violations "${source}")
		endif()
	elseif(source MATCHES "/src/gui/wxgui/components/wxTitleManagerList\\.cpp$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|CafeTitleList|CafeSaveList|TitleInfo|GameInfo2|TitleIdParser|FSC_|fsc_|ZArchive|FileStream|RegisterCallback|UnregisterCallback|#include[ \t]*[<\"]config/ActiveSettings|ActiveSettings::")
			list(APPEND title_manager_event_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/ChecksumTool\\.(h|cpp)$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|CafeTitleList|TitleInfo|GameInfo2|FSC_|fsc_(open|close|read)|wud_(open|close|readData|getWUDSize)|openssl/|EVP_|SHA256[(:]|#include[ \t]*[<\"]config/ActiveSettings|ActiveSettings::")
			list(APPEND checksum_ui_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/CemuUpdateWindow\\.(h|cpp)$")
		if(content MATCHES "config/ActiveSettings|ActiveSettings::")
			list(APPEND update_ui_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/MainWindow\\.cpp$")
		if(content MATCHES "ActiveSettings::Get(UserData|Mlc|Cache|Executable)Path")
			list(APPEND main_window_path_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/input/HotkeySettings\\.(h|cpp)$")
		if(content MATCHES "ActiveSettings::GetUserDataPath")
			list(APPEND hotkey_path_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/input/InputSettings2\\.(h|cpp)$")
		if(content MATCHES "config/ActiveSettings|ActiveSettings::GetConfigPath")
			list(APPEND input_settings_path_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/GeneralSettings2\\.(h|cpp)$")
		if(content MATCHES "ActiveSettings::Get(UserData|Mlc|Cache|Executable|Config)Path")
			list(APPEND general_settings_path_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/GameProfileWindow\\.(h|cpp)$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|Cafe/GameProfile|gameProfileIntegerOption_t|AccurateShaderMulOption|CPUMode::|GraphicAPI")
			list(APPEND game_profile_ui_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/GameUpdateWindow\\.(h|cpp)$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|TitleInfo|GameInfo2|TitleIdParser|ActiveSettings|fs::(rename|remove_all|recursive_directory_iterator|copy)")
			list(APPEND title_install_ui_violations "${source}")
		endif()
	endif()

	# Native wx event adapters consume frontend-neutral CEX2 value contracts.
	# Wire declarations and runtime hosts stay behind the Application adapter.
	if(source MATCHES "/src/gui/wxgui/")
		if(content MATCHES "cemuextend/services\\.hpp|cemuextend::wire|Cex2Host")
			list(APPEND wx_wire_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/WxFrontendRuntime\.cpp$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|CafeSystem::|CafeConsoleRegion|LatteGPUState|g_renderer|RendererAPI")
			list(APPEND wx_presentation_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/MainWindow\.cpp$")
		if(content MATCHES "VsyncDriver|VsyncDriver_notifyWindowPosChanged")
			list(APPEND wx_vsync_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/")
		if(content MATCHES "Cafe/OS/libs/swkbd|swkbd_(hasKeyboardInputHook|keyInput)")
			list(APPEND wx_swkbd_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/")
		if(content MATCHES "Cafe/OS/libs/nfc|nfc::TouchTagFromFile|NFC_TOUCH_TAG_ERROR_")
			list(APPEND wx_nfc_violations "${source}")
		endif()
	endif()

	# Normal wx startup, menu, and hotkey code only sees the neutral renderer
	# adapter. Renderer globals and backend-specific APIs stay in its target.
	if(source MATCHES "/src/gui/wxgui/(CemuApp|MainWindow|PadViewFrame|GeneralSettings2|input/HotkeySettings)\.cpp$")
		if(content MATCHES "Cafe/HW/Latte/(Core/LatteOverlay|Renderer/)|canvas/(OpenGL|Vulkan|Metal)Canvas|ActiveSettings::GetGraphicsAPI|g_renderer|g_vulkan_available|RendererAPI|MetalRenderer|LatteOverlay_init|InitializeGlobalVulkan")
			list(APPEND wx_renderer_adapter_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/GeneralSettings2\.cpp$")
		if(content MATCHES "Cafe/OS/libs/snd_core/ax\.h|snd_core::AX_|AX_FRAMES_PER_GROUP")
			list(APPEND wx_audio_spec_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/components/wxDownloadManagerList\.(h|cpp)$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/TitleList/|TitleIdParser|GameInfo2|TitleInfo")
			list(APPEND download_list_title_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/(CemuApp|MainWindow|GeneralSettings2|TitleManager)\.(h|cpp)$" OR
		source MATCHES "/src/gui/wxgui/dialogs/(CreateAccount|SaveImport)/.*\.(h|cpp)$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/Account/|#include[ \t]*[<\"]Cemu/ncrypto/|#include[ \t]*[<\"]Cafe/IOSU/legacy/iosu_crypto|Account::|NCrypto::")
			list(APPEND account_ui_violations "${source}")
		endif()
	endif()
	if(source MATCHES "/src/application/AccountFacade\.h$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|#include[ \t]*[<\"]wx|Account::|NCrypto::|CafeConsole")
			list(APPEND account_ui_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/dialogs/SaveImport/.*\.(h|cpp)$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|#include[ \t]*[<\"]config/ActiveSettings|#include[ \t]*[<\"]pugixml|#include[ \t]*[<\"]zip|ActiveSettings::GetMlcPath|pugi::|zip_(open|close|fopen|fread|file_add|dir_add)|coreinit::OSGetTime|ESPRESSO_TIMER_CLOCK|fs::(remove_all|rename|create_directories)")
			list(APPEND save_ui_violations "${source}")
		endif()
	elseif(source MATCHES "/src/gui/wxgui/TitleManager\.cpp$")
		if(content MATCHES "ActiveSettings::GetMlcPath|PopulateSavePersistentIds|pugi::|zip_(open|close|source_file|file_add|dir_add)|recursive_directory_iterator")
			list(APPEND save_ui_violations "${source}")
		endif()
	elseif(source MATCHES "/src/application/SaveFacade\.h$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|#include[ \t]*[<\"]wx|ActiveSettings|CafeSaveList|pugi::|zip_")
			list(APPEND save_ui_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/frontend/FrontendRuntime\.h$")
		if(content MATCHES "#include[ \t]*[<\"](Cafe/|wx|application/|gui/)|WindowSystem|CafeSystem")
			list(APPEND frontend_runtime_violations "${source}")
		endif()
	elseif(source MATCHES "/src/(main|mainLLE)\.cpp$")
		if(content MATCHES "WindowSystem::Create")
			list(APPEND frontend_runtime_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/helpers/wxHelpers\.(h|cpp)$")
		if(content MATCHES "gui/interface/WindowSystem\.h|WindowSystem::WindowHandleInfo")
			list(APPEND wx_native_handle_violations "${source}")
		endif()
	endif()
	if(source MATCHES "/src/gui/wxgui/.*\.(h|cpp)$" AND
		content MATCHES "WindowSystem::Publish(MainWindowHandle|PadWindowHandle|CanvasHandle)")
		list(APPEND wx_native_handle_violations "${source}")
	endif()

	# Mutable wx runtime state and the main-frame pointer are instance-owned.
	# Prevent the former process-wide globals and mutable WindowInfo escape hatch
	# from returning to normal frontend code.
	if(source MATCHES "/src/gui/(interface|wxgui)/.*\.(h|cpp)$")
		if(content MATCHES "g_window_info|g_mainFrame|g_mutex|WindowSystem::WindowInfo|GetWindowInfo")
			list(APPEND wx_window_state_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/application/EmulationController\.(h|cpp)$" OR
		source MATCHES "/src/gui/wxgui/.*\.(h|cpp)$")
		if(content MATCHES "SetTextInputWakeCallback")
			list(APPEND text_input_callback_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/(MainWindow|PadViewFrame)\.(h|cpp)$")
		if(content MATCHES "input/InputManager\.h|InputManager::instance|m_(main|pad)_(mouse|touch)|m_mouse_wheel")
			list(APPEND input_host_event_violations "${source}")
		endif()
	endif()

	if(source MATCHES "/src/gui/wxgui/windows/PPCThreadsViewer/DebugPPCThreadsWindow\.h$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|OSThread_t|VAddr|unordered_map")
			list(APPEND debugger_adapter_boundary_violations "${source}")
		endif()
	elseif(source MATCHES "/src/gui/wxgui/windows/PPCThreadsViewer/DebugPPCThreadsWindow\.cpp$")
		if(content MATCHES "wxProgressDialogManager|[.]detach[(]")
			list(APPEND debugger_adapter_boundary_violations "${source}")
		endif()
	elseif(source MATCHES "/src/gui/wxgui/debugger/SymbolCtrl\.h$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|MPTR|RPLStoredSymbol")
			list(APPEND debugger_adapter_boundary_violations "${source}")
		endif()
	elseif(source MATCHES "/src/gui/wxgui/debugger/Dump(Ctrl|Window)\.h$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|MMU|RPL|DebuggerWindow2")
			list(APPEND debugger_adapter_boundary_violations "${source}")
		endif()
	elseif(source MATCHES "/src/gui/wxgui/components/TextList\.(h|cpp)$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|#include[ \t]*[<\"]debugger/")
			list(APPEND debugger_adapter_boundary_violations "${source}")
		endif()
	elseif(source MATCHES "/src/gui/wxgui/helpers/wxCustomEvents\.(h|cpp)$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|#include[ \t]*[<\"]debugger/|MemorySearcherTool")
			list(APPEND debugger_adapter_boundary_violations "${source}")
		endif()
	elseif(source MATCHES "/src/gui/wxgui/debugger/DebuggerWindowAdapter\.h$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|DebuggerWindow2|s_debuggerWindow|GDBServer|g_gdbstub|MMU|RPL|MPTR|PPCSnapshot")
			list(APPEND debugger_adapter_boundary_violations "${source}")
		endif()
	elseif(source MATCHES "/src/gui/wxgui/debugger/MemorySearcherAdapter\.h$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|MMU|MemorySearcherTool|MEMPTR")
			list(APPEND debugger_adapter_boundary_violations "${source}")
		endif()
	elseif(source MATCHES "/src/gui/wxgui/(MainWindow|CemuApp)\.(h|cpp)$")
		if(content MATCHES "debugger/DebuggerWindow2\.h|s_debuggerWindow|GDBServer|g_gdbstub|EmulatedUSBDeviceFrame|MemorySearcherTool|Cafe/HW/MMU/MMU\.h|memory_getMMURanges")
			list(APPEND debugger_adapter_boundary_violations "${source}")
		endif()
	elseif(source MATCHES "/src/gui/wxgui/EmulatedUSBDevices/EmulatedUSBDeviceAdapter\.h$")
		if(content MATCHES "#include[ \t]*[<\"]Cafe/|nsyshid|Infinity|Skylander|Dimensions|EmulatedUSBDeviceFrame")
			list(APPEND debugger_adapter_boundary_violations "${source}")
		endif()
	endif()
endforeach()

if(locator_violations)
	list(JOIN locator_violations "\n  " formatted)
	message(FATAL_ERROR "Global HostServices locator is forbidden:\n  ${formatted}")
endif()
if(lower_gui_violations)
	list(JOIN lower_gui_violations "\n  " formatted)
