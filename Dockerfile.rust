# syntax=docker/dockerfile:1.7

# Keep this in lockstep with rust-toolchain.toml. The explicit image tag makes
# the compiler available before rustup evaluates the workspace override.
ARG RUST_VERSION=1.97.1
ARG CARGO_DENY_VERSION=0.20.2
ARG CARGO_ABOUT_VERSION=0.9.2
FROM rust:${RUST_VERSION}-bookworm AS rust-toolchain

ARG RUST_VERSION
ENV CARGO_INCREMENTAL=0 \
    CARGO_NET_GIT_FETCH_WITH_CLI=true \
    CARGO_TERM_COLOR=always \
    CARGO_TARGET_DIR=/workspace/target

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        ca-certificates \
        clang \
        cmake \
        git \
        libasound2-dev \
        libudev-dev \
        libwayland-dev \
        libx11-dev \
        libx11-xcb-dev \
        libxkbcommon-dev \
        libxrandr-dev \
        ninja-build \
        pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && rustup component add --toolchain "${RUST_VERSION}" clippy rustfmt

WORKDIR /workspace/CemuExtend

FROM rust-toolchain AS rust-unlocked-source

COPY . .

# Fail early if the Docker base and the repository pin drift apart.
RUN test "$(rustc --version | awk '{ print $2 }')" = "${RUST_VERSION}"

# Bootstrap target for a newly created workspace. Exporting this stage through
# BuildKit is the only supported way to create/update the host Cargo.lock.
FROM rust-unlocked-source AS rust-lockfile-builder

RUN --mount=type=cache,id=cemu-extend-rust-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cemu-extend-rust-git,target=/usr/local/cargo/git,sharing=locked \
    cargo generate-lockfile \
    && install -D -m 0644 Cargo.lock /opt/cemuextend/Cargo.lock

FROM scratch AS lockfile

COPY --from=rust-lockfile-builder /opt/cemuextend/Cargo.lock /Cargo.lock

FROM rust-unlocked-source AS rust-source

# Every normal verification/release target uses the exact dependency versions
# recorded in the repository's Cargo.lock.
RUN test -f Cargo.lock \
    && cargo metadata --locked --no-deps --format-version 1 >/dev/null \
    && bash -n docker-build-rust.sh \
    && bash -n docker-build-cpp-oracle.sh

FROM rust-source AS rust-format

RUN cargo fmt --all -- --check

FROM rust-source AS rust-format-fix-builder

RUN cargo fmt --all \
    && mkdir -p /opt/cemuextend/formatted \
    && cp -a Cargo.toml Cargo.lock rust-toolchain.toml crates /opt/cemuextend/formatted/

FROM scratch AS rust-format-fix

COPY --from=rust-format-fix-builder /opt/cemuextend/formatted/ /

FROM rust-format AS rust-check

RUN --mount=type=cache,id=cemu-extend-rust-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cemu-extend-rust-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=cemu-extend-rust-${RUST_VERSION}-x86_64-unknown-linux-gnu-check-target,target=/workspace/target,sharing=locked \
    cargo check --workspace --all-targets --locked

FROM rust-check AS rust-clippy

RUN --mount=type=cache,id=cemu-extend-rust-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cemu-extend-rust-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=cemu-extend-rust-${RUST_VERSION}-x86_64-unknown-linux-gnu-check-target,target=/workspace/target,sharing=locked \
    cargo clippy --workspace --all-targets --locked -- -D warnings

FROM rust-clippy AS rust-test

RUN --mount=type=cache,id=cemu-extend-rust-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cemu-extend-rust-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=cemu-extend-rust-${RUST_VERSION}-x86_64-unknown-linux-gnu-test-target,target=/workspace/target,sharing=locked \
    cargo test --workspace --all-targets --locked

FROM rust-test AS rust-deny

ARG CARGO_DENY_VERSION
RUN --mount=type=cache,id=cemu-extend-rust-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cemu-extend-rust-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=cemu-extend-rust-${RUST_VERSION}-x86_64-unknown-linux-gnu-deny-target,target=/workspace/target,sharing=locked \
    cargo install cargo-deny --version "${CARGO_DENY_VERSION}" --locked \
    && cargo deny check

# Rust verification target, including dependency advisories, license policy,
# bans, and source policy. The aggregate `ci` target also verifies the UI.
FROM rust-deny AS rust-ci

FROM rust-ci AS rust-builder

ARG CARGO_ABOUT_VERSION
RUN set -eu; \
    printf '%s\n' 'https://example.test/cemuextend/repository' > /tmp/cemuextend-notice-url.txt; \
    ! grep -Eq '(/workspace/|/usr/local/cargo/|/home/|(^|[^[:alnum:]_])[A-Za-z]:[\\/])' /tmp/cemuextend-notice-url.txt; \
    printf '%s\n' 'C:\secret' > /tmp/cemuextend-notice-drive-backslash.txt; \
    grep -Eq '(^|[^[:alnum:]_])[A-Za-z]:[\\/]' /tmp/cemuextend-notice-drive-backslash.txt; \
    printf '%s\n' 'C:/secret' > /tmp/cemuextend-notice-drive-slash.txt; \
    grep -Eq '(^|[^[:alnum:]_])[A-Za-z]:[\\/]' /tmp/cemuextend-notice-drive-slash.txt
RUN --mount=type=cache,id=cemu-extend-rust-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cemu-extend-rust-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=cemu-extend-rust-${RUST_VERSION}-x86_64-unknown-linux-gnu-release-target,target=/workspace/target,sharing=locked \
    cargo build --release --locked --package cemuextend --bin Cemu \
    && cargo build --release --locked --package cex-compat --bin cex-trace-compare \
    && cargo build --release --locked --package cemuextend --bin cex-rpx-fixture \
    && cargo build --release --locked --package cemuextend --bin cex-rpx-contract-trace \
    && install -D -m 0755 /workspace/target/release/Cemu /opt/cemuextend/bin/Cemu \
    && install -D -m 0755 /workspace/target/release/cex-trace-compare \
        /opt/cemuextend/bin/cex-trace-compare \
    && install -D -m 0755 /workspace/target/release/cex-rpx-fixture \
        /opt/cemuextend/bin/cex-rpx-fixture \
    && install -D -m 0755 /workspace/target/release/cex-rpx-contract-trace \
        /opt/cemuextend/bin/cex-rpx-contract-trace
RUN --mount=type=cache,id=cemu-extend-rust-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cemu-extend-rust-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=cemu-extend-rust-${RUST_VERSION}-cargo-about-target,target=/workspace/target,sharing=locked \
    cargo install cargo-about --version "${CARGO_ABOUT_VERSION}" --locked --features cli \
    && install -D -m 0644 LICENSE.txt /opt/cemuextend/licenses/LICENSE.txt \
    && cargo about generate \
        --config licenses/cargo-about.toml \
        --locked \
        --fail \
        --manifest-path crates/cemuextend/Cargo.toml \
        --target x86_64-unknown-linux-gnu \
        --output-file /opt/cemuextend/licenses/THIRD_PARTY_LICENSES.txt \
        licenses/cargo-about.hbs \
    && test -s /opt/cemuextend/licenses/LICENSE.txt \
    && test -s /opt/cemuextend/licenses/THIRD_PARTY_LICENSES.txt \
    && grep -Fq '# CemuExtend Rust dependency license notices' /opt/cemuextend/licenses/THIRD_PARTY_LICENSES.txt \
    && grep -Fq '## Rust packages' /opt/cemuextend/licenses/THIRD_PARTY_LICENSES.txt \
    && grep -Fq '## License texts' /opt/cemuextend/licenses/THIRD_PARTY_LICENSES.txt \
    && grep -Eq '^- `[^`]+` [0-9][^ ]* - https?://' /opt/cemuextend/licenses/THIRD_PARTY_LICENSES.txt \
    && grep -Fq -- '----- BEGIN LICENSE TEXT -----' /opt/cemuextend/licenses/THIRD_PARTY_LICENSES.txt \
    && awk 'BEGIN { in_text = 0; found = 0 } /----- BEGIN LICENSE TEXT -----/ { in_text = 1; next } /----- END LICENSE TEXT -----/ { in_text = 0 } in_text && /(Copyright|Permission is hereby granted|Apache License|Mozilla Public License|ISC License|ZLIB|Unicode)/ { found = 1 } END { exit found ? 0 : 1 }' /opt/cemuextend/licenses/THIRD_PARTY_LICENSES.txt \
    && ! grep -Eq '(/workspace/|/usr/local/cargo/|/home/|(^|[^[:alnum:]_])[A-Za-z]:[\\/])' /opt/cemuextend/licenses/THIRD_PARTY_LICENSES.txt \
    && ! grep -Eiq '(^|[^[:alnum:]_])(access[_-]?token|refresh[_-]?token|id[_-]?token|token|api[_-]?key|secret[_-]?key|client[_-]?secret|secret|credential|credentials|password|private[_-]?key|key)["]?[[:space:]]*[:=]' /opt/cemuextend/licenses/THIRD_PARTY_LICENSES.txt \
    && touch /opt/cemuextend/licenses/.license-bundle-verified

# Exercise the public trace producer and comparator through their real release
# binaries. This is a Rust self-consistency gate; it does not claim C++ oracle
# parity until the frozen reference runner emits the same canonical schema.
FROM rust-builder AS rust-oracle-smoke

RUN set -eu; \
    smoke_dir=/tmp/cemuextend-oracle-smoke; \
    mkdir -p "${smoke_dir}"; \
    /opt/cemuextend/bin/Cemu \
        --headless-fixture synthetic-rpx-boot \
        --trace-output "${smoke_dir}/expected.jsonl"; \
    /opt/cemuextend/bin/Cemu \
        --headless-fixture synthetic-rpx-boot \
        --trace-output "${smoke_dir}/actual.jsonl"; \
    /opt/cemuextend/bin/cex-trace-compare \
        --expected "${smoke_dir}/expected.jsonl" \
        --actual "${smoke_dir}/actual.jsonl" \
        --json-report "${smoke_dir}/match.json"; \
    grep -Fq '"match":true' "${smoke_dir}/match.json"; \
    /opt/cemuextend/bin/Cemu \
        --headless-fixture synthetic-boot \
        --trace-output "${smoke_dir}/different.jsonl"; \
    if /opt/cemuextend/bin/cex-trace-compare \
        --expected "${smoke_dir}/expected.jsonl" \
        --actual "${smoke_dir}/different.jsonl" \
        --json-report "${smoke_dir}/mismatch.json"; then \
        echo 'trace comparator accepted a divergent trace' >&2; \
        exit 1; \
    else \
        status=$?; \
        test "${status}" -eq 1; \
    fi; \
    grep -Fq '"match":false' "${smoke_dir}/mismatch.json"; \
    ! grep -Fq '/tmp/' "${smoke_dir}/match.json"; \
    ! grep -Fq '/tmp/' "${smoke_dir}/mismatch.json"; \
    if /opt/cemuextend/bin/cex-trace-compare \
        --expected "${smoke_dir}/private-sentinel.trace" \
        --actual "${smoke_dir}/actual.jsonl" \
        >"${smoke_dir}/invalid.stdout" 2>"${smoke_dir}/invalid.stderr"; then \
        echo 'trace comparator accepted a missing input' >&2; \
        exit 1; \
    else \
        status=$?; \
        test "${status}" -eq 2; \
    fi; \
    grep -Fxq 'unable to read or validate expected trace' "${smoke_dir}/invalid.stderr"; \
    ! grep -Fq 'private-sentinel' "${smoke_dir}/invalid.stderr"; \
    ! grep -Fq '/tmp/' "${smoke_dir}/invalid.stderr"; \
    test ! -s "${smoke_dir}/invalid.stdout"; \
    printf '%s\n' preserve >"${smoke_dir}/existing-report.json"; \
    if /opt/cemuextend/bin/cex-trace-compare \
        --expected "${smoke_dir}/expected.jsonl" \
        --actual "${smoke_dir}/actual.jsonl" \
        --json-report "${smoke_dir}/existing-report.json" \
        >"${smoke_dir}/existing.stdout" 2>"${smoke_dir}/existing.stderr"; then \
        echo 'trace comparator replaced an existing report' >&2; \
        exit 1; \
    else \
        status=$?; \
        test "${status}" -eq 2; \
    fi; \
    grep -Fxq 'unable to write comparison report' "${smoke_dir}/existing.stderr"; \
    test "$(cat "${smoke_dir}/existing-report.json")" = preserve; \
    test ! -s "${smoke_dir}/existing.stdout"; \
    touch /opt/cemuextend/oracle-smoke-verified

# BuildKit-exported RPX fixture and canonical three-record contract trace.
FROM rust-builder AS rust-rpx-contract-artifacts-builder

RUN set -eu; \
    mkdir -p /opt/cemuextend/rpx-contract; \
    /opt/cemuextend/bin/cex-rpx-fixture \
        > /opt/cemuextend/rpx-contract/fixture.rpx; \
    /opt/cemuextend/bin/cex-rpx-contract-trace \
        --fixture /opt/cemuextend/rpx-contract/fixture.rpx \
        --trace-output /opt/cemuextend/rpx-contract/rust-trace.jsonl; \
    test -s /opt/cemuextend/rpx-contract/fixture.rpx; \
    test -s /opt/cemuextend/rpx-contract/rust-trace.jsonl; \
    install -D -m 0755 /opt/cemuextend/bin/cex-trace-compare \
        /opt/cemuextend/rpx-contract/cex-trace-compare; \
    cd /opt/cemuextend/rpx-contract; \
    sha256sum fixture.rpx rust-trace.jsonl cex-trace-compare > SHA256SUMS

FROM scratch AS rust-rpx-contract-artifacts

COPY --from=rust-rpx-contract-artifacts-builder /opt/cemuextend/rpx-contract/ /

# Rebuild the current synthetic fixture and Rust trace, then compare them with
# the tracked trace attested by the fixed C++ oracle. The manifest also pins the
# adapter sources, so changing the manual oracle path requires an explicit
# golden/manifest review even though CI does not rebuild the historical tree.
FROM rust-builder AS rust-rpx-golden-gate

RUN set -eu; \
    gate_dir=/tmp/cemuextend-rpx-golden-gate; \
    manifest=compat/golden/rpx-contract-positive-v1.manifest.json; \
    golden=compat/golden/rpx-contract-positive-v1.jsonl; \
    mkdir -p "${gate_dir}"; \
    /opt/cemuextend/bin/cex-rpx-fixture > "${gate_dir}/fixture.rpx"; \
    /opt/cemuextend/bin/cex-rpx-contract-trace \
        --fixture "${gate_dir}/fixture.rpx" \
        --trace-output "${gate_dir}/rust-actual.jsonl"; \
    manifest_value() { \
        awk -v key="$1" ' \
            $0 ~ "^[[:space:]]*\"" key "\"[[:space:]]*:" { \
                value = $0; \
                sub("^[[:space:]]*\"" key "\"[[:space:]]*:[[:space:]]*", "", value); \
                sub(",[[:space:]]*$", "", value); \
                sub("^[[:space:]]*\"", "", value); \
                sub("\"[[:space:]]*$", "", value); \
                print value; \
            } \
        ' "${manifest}"; \
    }; \
    assert_manifest_sha256() { \
        expected="$(manifest_value "$2")"; \
        test "$(printf '%s' "${expected}" | wc -c)" -eq 64; \
        printf '%s\n' "${expected}" | grep -Eq '^[0-9a-f]{64}$'; \
        actual="$(sha256sum "$1" | cut -d ' ' -f1)"; \
        test "${actual}" = "${expected}"; \
    }; \
    test "$(manifest_value schema_version)" = 1; \
    test "$(manifest_value oracle_commit)" = ab0b772029f0a5cd57c194cf338003fe8eae8ab8; \
    test "$(manifest_value oracle_attestation)" = 'cex-trace-compare exit 0 against fixed C++ oracle output'; \
    test "$(manifest_value scope)" = 'positive parse/map only'; \
    test "$(manifest_value fixture_producer)" = cex-rpx-fixture; \
    test "$(manifest_value golden_trace_path)" = "${golden}"; \
    test "$(manifest_value adapter_cmake_path)" = compat/cpp-oracle/CMakeLists.txt; \
    test "$(manifest_value adapter_source_path)" = compat/cpp-oracle/rpx_oracle_trace.cpp; \
    test "$(manifest_value golden_trace_records)" -eq 3; \
    test "$(wc -l < "${golden}")" -eq "$(manifest_value golden_trace_records)"; \
    test "$(wc -l < "${gate_dir}/rust-actual.jsonl")" -eq "$(manifest_value golden_trace_records)"; \
    assert_manifest_sha256 "${gate_dir}/fixture.rpx" fixture_sha256; \
    assert_manifest_sha256 "${golden}" golden_trace_sha256; \
    assert_manifest_sha256 compat/cpp-oracle/CMakeLists.txt adapter_cmake_sha256; \
    assert_manifest_sha256 compat/cpp-oracle/rpx_oracle_trace.cpp adapter_source_sha256; \
    /opt/cemuextend/bin/cex-trace-compare \
        --expected "${golden}" \
        --actual "${gate_dir}/rust-actual.jsonl"; \
    touch /opt/cemuextend/rpx-golden-gate-verified

# Runnable Linux headless image. No React/CEF or native desktop frontend is
# pulled into this path.
FROM debian:bookworm-slim AS rust-headless

RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# `groupadd` and `useradd` are supplied by Debian's required `passwd` package;
# keep this numeric identity fixed so the final image cannot default to root.
RUN groupadd --gid 10001 cemu \
    && useradd --uid 10001 --gid 10001 --no-create-home \
        --shell /usr/sbin/nologin cemu

COPY --from=rust-builder /opt/cemuextend/bin/Cemu /usr/local/bin/Cemu
COPY --from=rust-builder /opt/cemuextend/licenses/ /usr/share/licenses/cemuextend/

# Bind-mounted fixtures and trace-output directories must be readable/writable
# by UID/GID 10001; configuring those mount permissions is the caller's job.
USER 10001:10001

ENTRYPOINT ["/usr/local/bin/Cemu"]
CMD ["--headless-fixture", "synthetic-boot"]

# Local-output target used by docker-build-rust.sh. It exports one executable
# without requiring docker create, docker run, or cargo on the host.
FROM scratch AS rust-release

COPY --from=rust-builder /opt/cemuextend/bin/Cemu /Cemu
COPY --from=rust-builder /opt/cemuextend/licenses/LICENSE.txt /LICENSE.txt
COPY --from=rust-builder /opt/cemuextend/licenses/THIRD_PARTY_LICENSES.txt /THIRD_PARTY_LICENSES.txt

# The existing React application remains opt-in until the desktop milestone.
# This shared source stage feeds both the read-only UI checks and the formatter
# export target without pulling Bun into the Rust images.
FROM oven/bun:1.2.21-debian AS rust-ui-source

WORKDIR /workspace/CemuExtend
COPY ui/package.json ui/bun.lock ./ui/
RUN --mount=type=cache,id=cemu-extend-rust-ui-bun,target=/root/.bun/install/cache,sharing=locked \
    cd ui && bun install --frozen-lockfile
COPY ui/ ./ui/
COPY crates/cex-contracts/src/generated.rs ./crates/cex-contracts/src/generated.rs

FROM rust-ui-source AS rust-ui-format-fix-builder

RUN cd ui \
    && bun run format \
    && rm -rf node_modules .bun \
    && mkdir -p /opt/cemuextend/formatted \
    && cp -a /workspace/CemuExtend/ui /opt/cemuextend/formatted/

FROM scratch AS rust-ui-format-fix

COPY --from=rust-ui-format-fix-builder /opt/cemuextend/formatted/ui/ /ui/

FROM rust-ui-source AS rust-ui

RUN cp -a ui/src/generated /tmp/ui-generated \
    && cp crates/cex-contracts/src/generated.rs /tmp/contracts-generated.rs \
    && cd ui \
    && bun run scripts/generate-contracts.ts \
    && diff -ru /tmp/ui-generated src/generated \
    && diff -u /tmp/contracts-generated.rs ../crates/cex-contracts/src/generated.rs \
    && bun run format:check \
    && bun run typecheck \
    && bun run lint \
    && bun test \
    && bun run build \
    && touch /ui-verified

# Aggregate CI target. Copying the markers gives BuildKit an explicit dependency
# on the Rust verification graph, release notice generation, and UI verification
# without adding Bun to the Rust image.
FROM rust-ci AS ci

COPY --from=rust-builder /opt/cemuextend/licenses/.license-bundle-verified /opt/cemuextend/license-gate/.license-bundle-verified
COPY --from=rust-builder /opt/cemuextend/licenses/LICENSE.txt /opt/cemuextend/license-gate/LICENSE.txt
COPY --from=rust-builder /opt/cemuextend/licenses/THIRD_PARTY_LICENSES.txt /opt/cemuextend/license-gate/THIRD_PARTY_LICENSES.txt
COPY --from=rust-oracle-smoke /opt/cemuextend/oracle-smoke-verified /opt/cemuextend/oracle-smoke-verified
COPY --from=rust-rpx-golden-gate /opt/cemuextend/rpx-golden-gate-verified /opt/cemuextend/rpx-golden-gate-verified
COPY --from=rust-ui /ui-verified /opt/cemuextend/ui-verified
